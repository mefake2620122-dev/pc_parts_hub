# ==============================================================================
# PC PART HUB - Vercel & Production Environment Variables
# In Vercel: Project Settings > Environment Variables
# ==============================================================================

# 1. Supabase Cloud PostgreSQL & Storage (Mandatory for Vercel Persistence)
# Obtain from: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_ANON_KEY=your-anon-public-key

# 2. JWT Authentication Secret
JWT_SECRET=pc_parts_hub_secure_jwt_secret_token_key_2026

# 3. Optional Admin Master Password
# ADMIN_PASSWORD=your_emergency_admin_password
