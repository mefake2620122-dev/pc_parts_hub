# ==============================================================================
# PC PART HUB - Server Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=production

# JWT Authentication Secret (Used for admin session tokens)
JWT_SECRET=pc_parts_hub_secure_jwt_secret_token_key_2026

# Admin Master Password Override (Optional)
ADMIN_PASSWORD=

# Initial Admin credentials (Default fallback when seeding)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=pcparthub@2026

# ==============================================================================
# SUPABASE CLOUD DATABASE CONFIGURATION (For Vercel & Production Persistence)
# Get these from: Supabase Dashboard > Project Settings > API
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
